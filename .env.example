# Collection is OFF by default. Never put these values in VITE_* variables.
RESEARCH_MODE=off
RESEARCH_ORIGIN=http://127.0.0.1:4174
RESEARCH_STUDY_ID=neural-lab-pilot
RESEARCH_BUILD_ID=development
# Local UI testing only: set RESEARCH_MODE=local (in-memory sink, synthetic account).
# Real collection is intentionally unconfigured, including app deployments.
GOOGLE_CLIENT_ID=
RESEARCH_SESSION_KEY=
RESEARCH_PSEUDONYM_KEY=
# 32 random bytes encoded as base64, distinct from all other secrets.
RESEARCH_IDENTITY_KEY=
RESEARCH_SHEETS_GATEWAY_URL=
RESEARCH_SHEETS_GATEWAY_SECRET=
RESEARCH_ENROLLMENT_CODE=
RESEARCH_CONSENT_VERSION=draft-v1
RESEARCH_PROFILE_APPROVED=false
# Empty uses the supplied 17 items with six confidence anchors. JSON is an optional override.
RESEARCH_INSTRUMENT_JSON=
